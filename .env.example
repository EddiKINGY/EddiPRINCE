# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# CLIENT-SIDE ENVIRONMENT VARIABLES (Vite / Browser)
# Strictly public, non-sensitive configuration values.
# -----------------------------------------------------------------------------

# --- 1. Privacy-First Analytics ---
# Provider: 'none' (default), 'plausible', 'umami', or 'custom'
# Privacy: Strictly anonymous event tracking with zero cookies, zero PII, and full DNT honor.
# Fallback: Operates in silent no-op mode when undefined.
VITE_ANALYTICS_PROVIDER="none"
VITE_ANALYTICS_DOMAIN=""
VITE_ANALYTICS_API_HOST=""

# --- 2. Web Vitals Performance Monitoring ---
# Purpose: Collect browser Core Web Vitals (LCP, CLS, FID/INP) using standard PerformanceObserver.
# Privacy: Purely anonymous millisecond performance numbers; zero user tracking.
# Values: "true" | "false" (default: "false")
VITE_PERF_MONITORING_ENABLED="false"

# -----------------------------------------------------------------------------
# SERVER-SIDE INTEGRATION SECRETS (Cloudflare Workers / Serverless Boundary)
# Configure these in your Cloudflare dashboard (Settings > Variables and Secrets).
# These secrets are NEVER exposed to client bundles or browser dev tools.
# -----------------------------------------------------------------------------

# --- 3. Beehiiv Newsletter Service (Server Boundary: /functions/api/newsletter) ---
# BEEHIIV_API_KEY: Secret API key for authenticating with Beehiiv API v2.
# BEEHIIV_PUBLICATION_ID: Publication UUID for the target subscriber list.
BEEHIIV_API_KEY=""
BEEHIIV_PUBLICATION_ID=""

# --- 4. Contact & Dispatches Service (Server Boundary: /functions/api/contact) ---
# CONTACT_EMAIL: Verified destination email where form dispatches are delivered.
# EMAIL_PROVIDER_API_KEY: Secret API key for transactional email provider (e.g., Resend).
# CONTACT_WEBHOOK_URL: Optional private webhook endpoint (Discord/Slack/Zapier/CRM) on worker.
CONTACT_EMAIL="davidabbahinnocent@gmail.com"
EMAIL_PROVIDER_API_KEY=""
CONTACT_WEBHOOK_URL=""

