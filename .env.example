# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS & SERVICES
# All integrations are opt-in. When undefined, the app uses safe local fallbacks.
# -----------------------------------------------------------------------------

# --- 1. Privacy-First Analytics ---
# Provider: 'none' (default), 'plausible', 'umami', or 'custom'
# Privacy: Strictly anonymous event tracking with zero cookies, zero PII, and full DNT honor.
# Fallback: Operates in silent no-op mode when undefined.
VITE_ANALYTICS_PROVIDER="none"
VITE_ANALYTICS_DOMAIN=""
VITE_ANALYTICS_API_HOST=""

# --- 2. Newsletter Subscription Webhook ---
# Purpose: HTTPS webhook endpoint to deliver newsletter submissions to an external list provider.
# Privacy: Transmitted over encrypted HTTPS; only the submitted email is forwarded.
# Fallback: Persists to browser localStorage queue if undefined or unreachable.
VITE_NEWSLETTER_WEBHOOK_URL=""

# --- 3. Contact Inquiries Webhook ---
# Purpose: HTTPS webhook endpoint to route contact dispatches to your email/CRM inbox.
# Privacy: Dispatches are sent directly to the destination endpoint without intermediate advertising brokers.
# Fallback: Generates an EP-XXXXX local reference ID and provides a direct mailto link.
VITE_CONTACT_WEBHOOK_URL=""

# --- 4. Web Vitals Performance Monitoring ---
# Purpose: Collect browser Core Web Vitals (LCP, CLS, FID/INP) using standard PerformanceObserver.
# Privacy: Purely anonymous millisecond performance numbers; zero user tracking.
# Values: "true" | "false" (default: "false")
VITE_PERF_MONITORING_ENABLED="false"

